<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">

    <deploymentStatus>Deployed</deploymentStatus>

    <label>Sales Performance</label>
    <pluralLabel>Sales Performances</pluralLabel>

    <nameField>
        <label>Performance Number</label>
        <type>AutoNumber</type>
        <displayFormat>PERF-{00000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>

    <sharingModel>ReadWrite</sharingModel>

    <!-- Sales Rep → standard User -->
    <fields>
        <fullName>Sales_Rep__c</fullName>
        <label>Sales Rep</label>
        <type>Lookup</type>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Sales Performances</relationshipLabel>
        <relationshipName>SalesPerformances</relationshipName>
    </fields>

    <!-- Store → Store__c -->
    <fields>
        <fullName>Store__c</fullName>
        <label>Store</label>
        <type>Lookup</type>
        <referenceTo>Store__c</referenceTo>
        <relationshipLabel>Sales Performances</relationshipLabel>
        <relationshipName>SalesPerformances</relationshipName>
    </fields>

    <fields>
        <fullName>Period__c</fullName>
        <label>Period</label>
        <type>Date</type>
    </fields>

    <fields>
        <fullName>Sales_Amount__c</fullName>
        <label>Sales Amount</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
    </fields>

    <fields>
        <fullName>Target__c</fullName>
        <label>Target</label>
        <type>Currency</type>
        <precision>16</precision>
        <scale>2</scale>
    </fields>

    <fields>
        <fullName>Achievement__c</fullName>
        <label>Achievement</label>
        <type>Percent</type>
        <precision>5</precision>
        <scale>2</scale>
    </fields>

</CustomObject>